{
  "id": null,
  "uid": "distributed-kv-store",
  "title": "Distributed Key-Value Store",
  "schemaVersion": 39,
  "version": 1,
  "timezone": "browser",
  "refresh": "10s",
  "templating": {
    "list": [
      {
        "name": "node",
        "label": "Node",
        "type": "query",
        "datasource": "Prometheus",
        "query": "label_values(kv_ops_total, instance)",
        "refresh": 1,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": ["All"],
          "value": ["$__all"]
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Ops/sec",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum by (instance) (rate(kv_ops_total{instance=~\"$node\"}[1m]))",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "P50/P95/P99 Latency",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le, instance) (rate(kv_op_duration_seconds_bucket{instance=~\"$node\"}[1m])))",
          "legendFormat": "P50 {{instance}}"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, instance) (rate(kv_op_duration_seconds_bucket{instance=~\"$node\"}[1m])))",
          "legendFormat": "P95 {{instance}}"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le, instance) (rate(kv_op_duration_seconds_bucket{instance=~\"$node\"}[1m])))",
          "legendFormat": "P99 {{instance}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Raft Leader",
      "datasource": "Prometheus",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "raft_is_leader{instance=~\"$node\"}",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Raft Term",
      "datasource": "Prometheus",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 8 },
      "targets": [
        {
          "expr": "raft_term{instance=~\"$node\"}",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "barchart",
      "title": "Key Count Per Node",
      "datasource": "Prometheus",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 8 },
      "targets": [
        {
          "expr": "store_keys_total{instance=~\"$node\"}",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "gRPC Error Rate",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 14 },
      "targets": [
        {
          "expr": "sum by (instance) (rate(grpc_requests_total{status!~\"ok|success\",instance=~\"$node\"}[1m]))",
          "legendFormat": "{{instance}}"
        }
      ]
    }
  ]
}
